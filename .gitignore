# Keep identified simulator artifacts; ignore build caches.
.pio/*
!.pio/build/
.pio/build/*
!.pio/build/esp32dev/
.pio/build/esp32dev/*
!.pio/build/esp32dev/firmware.bin
!.pio/build/esp32dev/firmware.elf
!.pio/build/esp32dev/bootloader.bin
!.pio/build/esp32dev/partitions.bin
validation/device/.pio/*
!validation/device/.pio/build/
validation/device/.pio/build/*
!validation/device/.pio/build/live_validation/
validation/device/.pio/build/live_validation/*
!validation/device/.pio/build/live_validation/firmware.bin
!validation/device/.pio/build/live_validation/firmware.elf
!validation/device/.pio/build/live_validation/bootloader.bin
!validation/device/.pio/build/live_validation/partitions.bin
validation/sensor/.pio/*
!validation/sensor/.pio/build/
validation/sensor/.pio/build/*
!validation/sensor/.pio/build/sensor_validation/
validation/sensor/.pio/build/sensor_validation/*
!validation/sensor/.pio/build/sensor_validation/firmware.bin
!validation/sensor/.pio/build/sensor_validation/firmware.elf
!validation/sensor/.pio/build/sensor_validation/bootloader.bin
!validation/sensor/.pio/build/sensor_validation/partitions.bin
.vscode/.browse.c_cpp.db*
validation/campaign/.pio/*
!validation/campaign/.pio/build/
validation/campaign/.pio/build/*
!validation/campaign/.pio/build/campaign/
validation/campaign/.pio/build/campaign/*
!validation/campaign/.pio/build/campaign/firmware.bin
!validation/campaign/.pio/build/campaign/firmware.elf
!validation/campaign/.pio/build/campaign/bootloader.bin
!validation/campaign/.pio/build/campaign/partitions.bin
.vscode/c_cpp_properties.json
.vscode/launch.json
__pycache__/
.pytest_cache/
*.vcd
!evidence/runs/uart/*.vcd
.env
.venv/
/runs/
